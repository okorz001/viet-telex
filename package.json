{
  "name": "viet-telex",
  "private": true,
  "version": "1.0.0",
  "description": "Vietnamese Telex decoding",
  "type": "module",
  "sideEffects": "false",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "docs": "typedoc",
    "lint": "eslint --max-warnings 0 src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "demo": "vite --port 8080",
    "build:demo": "vite build",
    "verify": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okorz001/viet-telex.git"
  },
  "keywords": [
    "vietnamese"
  ],
  "author": "Oscar Korz <okorz001@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/okorz001/viet-telex/issues"
  },
  "homepage": "https://github.com/okorz001/viet-telex#readme",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.1.0",
    "eslint-plugin-tsdoc": "^0.5.3",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
